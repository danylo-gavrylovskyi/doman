# Root env used by docker-compose (docker-compose --env-file .env ...)

# Ports exposed on the host
PORT=5000
FRONTEND_PORT=3000

# Database (PostgreSQL)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=doman

# Auth — use long, random, DISTINCT values for each secret
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000

# Order notification email (nodemailer / gmail)
USER=your_gmail_address@gmail.com
PASS=your_gmail_app_password
FROM=your_gmail_address@gmail.com
TO=admin_inbox@gmail.com

# Frontend build-time API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public storefront URL — used for canonical URLs, sitemap, robots.txt and OG tags.
# Set to your real production domain (e.g. https://doman.com.ua).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# On-demand ISR revalidation. FRONTEND_URL is the internal origin the backend
# uses to reach the frontend (service name inside the docker network).
# REVALIDATE_SECRET is a shared secret used by both backend and frontend.
FRONTEND_URL=http://frontend:3000
REVALIDATE_SECRET=change_me_shared_revalidate_secret

# Object storage for uploaded images (Cloudflare R2 / S3-compatible), used by the backend.
R2_ENDPOINT=https://your_account_id.r2.cloudflarestorage.com
R2_REGION=auto
R2_ACCESS_KEY_ID=change_me
R2_SECRET_ACCESS_KEY=change_me
R2_BUCKET=doman-uploads

# Public base URL for uploaded images, baked into the frontend bundle.
# Set to your R2 public bucket URL or CDN domain (no trailing slash).
NEXT_PUBLIC_UPLOADS_URL=https://pub-xxxxxxxx.r2.dev
