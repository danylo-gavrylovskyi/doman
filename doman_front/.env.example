# Base URL of the backend API (baked into the client bundle at build time)
NEXT_PUBLIC_API_URL=http://localhost:5000

# Public production URL of the storefront. Used for canonical URLs, sitemap,
# robots.txt and Open Graph/Twitter tags. Set this to your real domain in prod.
NEXT_PUBLIC_SITE_URL=https://doman.com.ua

# Shared secret guarding the /api/revalidate on-demand ISR endpoint.
# Must match the backend's REVALIDATE_SECRET. Server-only (never NEXT_PUBLIC).
REVALIDATE_SECRET=change_me_shared_revalidate_secret

# Public base URL for uploaded images (object storage / CDN, no trailing slash).
# e.g. https://pub-xxxx.r2.dev or your CDN domain. If unset, falls back to
# ${NEXT_PUBLIC_API_URL}/uploads (backend-served, for local dev only).
NEXT_PUBLIC_UPLOADS_URL=https://pub-xxxxxxxx.r2.dev
