# Server
PORT=5000

# Database (PostgreSQL)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_DATABASE=doman

# Auth — use long, random, DISTINCT values for each secret
JWT_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret

# CORS — comma-separated list of allowed frontend origins.
# Leave empty only for local development (reflects request origin).
CORS_ORIGINS=http://localhost:3000

# Order notification email (nodemailer / gmail)
USER=your_gmail_address@gmail.com
PASS=your_gmail_app_password
FROM=your_gmail_address@gmail.com
TO=admin_inbox@gmail.com

# On-demand ISR revalidation (server-to-server call to the Next.js frontend).
# FRONTEND_URL is the internal frontend origin the backend can reach
# (e.g. http://frontend:3000 in docker, http://localhost:3000 locally).
# REVALIDATE_SECRET must match the frontend's REVALIDATE_SECRET.
FRONTEND_URL=http://localhost:3000
REVALIDATE_SECRET=change_me_shared_revalidate_secret
